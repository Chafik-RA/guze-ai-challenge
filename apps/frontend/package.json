{
  "name": "ai-challenge-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@ai-challenge/shared": "*",
    "@angular/animations": "^20.3.28",
    "@angular/common": "20.3.28",
    "@angular/compiler": "20.3.28",
    "@angular/core": "20.3.28",
    "@angular/forms": "20.3.28",
    "@angular/platform-browser": "20.3.28",
    "@angular/router": "20.3.28",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.34",
    "@angular/cli": "~20.3.34",
    "@angular/compiler-cli": "20.3.28",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.2"
  }
}
