# Copy this to .env and adjust if needed. .env should be in .gitignore.

# --- Database (used by postgres service + backend's DATABASE_URL) ---
DB_NAME=ai_challenge
DB_USER=ai_challenge
DB_PASSWORD=ai_challenge_local
DB_PORT=5432

# --- Backend ---
NODE_ENV=development
PORT=3000
# Only needed if you run `npm run dev` directly on the host (outside docker compose),
# since inside compose this is already wired via the backend service's `environment:` block.
DATABASE_URL=postgres://ai_challenge:ai_challenge_local@localhost:5432/ai_challenge

# Secret used to sign/verify session tokens (auth middleware, week 1).
# Any random string works for local/demo — do not reuse this literal value anywhere real.
SESSION_TOKEN_SECRET=change-me-local-dev-secret

# --- Frontend ---
# Angular doesn't read .env directly — this is here so you have one place documenting
# what environment.ts should point to. For now it's fine to hardcode this value there instead.
API_BASE_URL=http://localhost:3000

# --- Added later (week 2+, not needed yet) ---
# OTP_MOCK_VALUE=123456
# SUPABASE_DB_URL=
